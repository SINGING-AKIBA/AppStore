  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "local": "cross-env NODE_ENV=local mwtsc --watch --run @midwayjs/mock/app.js",
    "dev": "cross-env NODE_ENV=dev mwtsc --watch --run @midwayjs/mock/app.js",
    "test": "cross-env NODE_ENV=local node --experimental-vm-modules node_modules/jest/bin/jest.js --testTimeout=130000 --forceExit",
    "cov": "jest --coverage",
    "lint": "mwts check",
    "lint:fix": "mwts fix",
    "ci": "pnpm run cov",
    "build": "pnpm scan:entities && mwtsc --cleanOutDir",
    "pkg": "rimraf release && mkdir release && pnpm run build && pkg . -d > release/pkg.log",
    "pkg:test": "cross-env NODE_ENV=local node ./bootstrap.js",
    "pkg:fast": "cross-env PKG_CACHE_PATH=.pkg-cache PKG_REMOTE_URL_BASE=https://registry.pnpmmirror.com/binary.html?path=pkg-fetch pnpm run pkg",
    "scan:entities": "node packages/entity-scanner/src/index.mjs"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "node_modules/axios/dist/node/*"
    ],
    "assets": [
      "public/**/*",
      "node_modules/html-pdf-node/**/*",
      "node_modules/canvas/**/*",
      "node_modules/bcrypt/**/*",
      "basic_model.conf"
    ],
    "targets": [
      "node22-win-x64",
      "node22-linux-x64"
    ],
    "outputPath": "release"
  },
  "bin": "./bootstrap.js",
  "author": "smile",
  "license": "MIT"
}
