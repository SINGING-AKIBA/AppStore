<script setup>
import { Line } from '@antv/g2plot';
import dayjs  from 'dayjs';
import * as api from '@/api/index';
import { ref,onMounted } from 'vue';
const isLoading = ref(false);
const container = ref('');
const defaultData = ref([]);
const user = ref({});
const create_time = ref([]);
onMounted(()=>{
  createLine();
  getUserData();
  statistics();
})
function getUserData(){
  api.index().then(res=>{
    user.value = res.data
  })
}
function statistics(){
  let query = {}
  if(create_time.value.length>0){
    query.create_time = create_time.value;
  }
  api.statistics(query).then(res=>{
      let {data} = res;
      if(data.length>0){
        let LineData = [];
        let series = {money:"销售金额",user:"注册用户",ad:"广告参与",points:"K点消费",points_add:"K点新增",play:"播放数量",user_active:"活跃用户"};
        data.forEach(item=>{
        Object.entries(series).forEach(([key, value]) => {
          LineData.push({'date':dayjs(item.create_time).format('DD'),'value':parseInt(item[key]),'series':value})
        });
        })
        container.value.changeData(LineData)
      }
  })
}
function pickerChange(dates) {
  this.statistics()
}
function createLine(){
  let data = []
  const series = ["销售金额","注册用户","广告参与","K点消费","K点新增","播放数量","活跃用户"];
  for(let i=0;i<32;i++){
    series.forEach(item=>{
      //生成随机数
      let value = 0
      data.push({'date':i+1,'value':value,'series':item})
    })
  }
  defaultData.value = data
  container.value = new Line('container', {
      data,
      xField: 'date',
      yField: 'value',
      seriesField: 'series',
    });
  container.value.render()
}
</script>
